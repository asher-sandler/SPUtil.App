<Window x:Class="SPUtil.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About SPUtil"
        Height="420" Width="320"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Open (Fade-in + Scale) -->
        <Storyboard x:Key="OpenAnimation">
            <DoubleAnimation Storyboard.TargetName="MainContainer"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.25"/>
            <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                             Storyboard.TargetProperty="ScaleX"
                             From="0.85" To="1" Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                             Storyboard.TargetProperty="ScaleY"
                             From="0.85" To="1" Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Close (Fade-out + Scale) -->
        <Storyboard x:Key="CloseAnimation" Completed="CloseAnimation_Completed">
            <DoubleAnimation Storyboard.TargetName="MainContainer"
                             Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                             Storyboard.TargetProperty="ScaleX"
                             To="0.9" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                             Storyboard.TargetProperty="ScaleY"
                             To="0.9" Duration="0:0:0.2"/>
        </Storyboard>
		
		<!-- AboutWindow.xaml, Window.Resources — добавить рядом с OpenAnimation/CloseAnimation -->
		<Storyboard x:Key="CreditsAnimation">
			<DoubleAnimation Storyboard.TargetName="CreditsTransform"
                     Storyboard.TargetProperty="Y"
                     From="200" To="0"
                     Duration="0:0:4"/>
		</Storyboard>		
    </Window.Resources>

    <Border x:Name="MainContainer"
            Background="White"
            CornerRadius="12"
            BorderBrush="#E0E0E0"
            BorderThickness="1"
            Margin="15"
            Opacity="0"
            RenderTransformOrigin="0.5,0.5"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">
        
        <!-- Shadow -->
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.15" Color="Black"/>
        </Border.Effect>

        <Border.RenderTransform>
            <ScaleTransform x:Name="ScaleTransform" ScaleX="0.85" ScaleY="0.85"/>
        </Border.RenderTransform>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Логотип -->
                <RowDefinition Height="*"/>    <!-- Информация -->
                <RowDefinition Height="Auto"/> <!-- Кнопка OK -->
            </Grid.RowDefinitions>

            <!-- Logo -->
            <Image Grid.Row="0"
                   Source="pack://application:,,,/SPUtil.App;component/Views/BigColorLogo.png"
                   Height="130"
                   Margin="0,10,0,15"
                   RenderOptions.BitmapScalingMode="HighQuality"/>

            <!--Developer -->
			<Grid Grid.Row="1" ClipToBounds="True">
				<StackPanel x:Name="CreditsPanel"
							VerticalAlignment="Top"
							HorizontalAlignment="Center">
					<StackPanel.RenderTransform>
						<TranslateTransform x:Name="CreditsTransform" Y="200"/>
					</StackPanel.RenderTransform>

					<TextBlock Text="SPUtil" 
							   FontSize="20" 
							   FontWeight="Bold" 
							   Foreground="#2B579A" 
							   HorizontalAlignment="Center"/>

					<TextBlock Text="Version 1.0" 
							   FontSize="12" 
							   Foreground="#888888" 
							   HorizontalAlignment="Center" 
							   Margin="0,2,0,12"/>

					<Separator Width="120" Background="#E5E5E5" Margin="0,0,0,12"/>

					<TextBlock Text="Developer:" 
							   FontSize="11" 
							   Foreground="#666666" 
							   HorizontalAlignment="Center"/>

					<TextBlock Text="Asher Sandler" 
							   FontSize="12" 
							   FontWeight="SemiBold" 
							   Foreground="#333333" 
							   HorizontalAlignment="Center" 
							   Margin="0,2,0,0"/>



					<TextBlock Text="ashersan@savion.huji.ac.il"
							   FontSize="12"
							   FontWeight="SemiBold"
							   Foreground="#333333"
							   HorizontalAlignment="Center"
							   Cursor="Hand"
							   Margin="0,2,0,0"
							   MouseLeftButtonDown="Email_Click"
							   ToolTip="Click to copy email address"/>

					<TextBlock Text="Computing Department" 
							   FontSize="14" 
							   FontWeight="SemiBold" 
							   Foreground="#333333" 
							   HorizontalAlignment="Center" 
							   Margin="0,2,0,0"/>
				</StackPanel>
			</Grid>

			<Button Grid.Row="2"
					Content="OK"
					Height="34"
					Width="100"
					HorizontalAlignment="Center"
					Click="BtnOk_Click"
					IsDefault="True"
					Foreground="White"
					FontWeight="SemiBold"
					Margin="0,10,0,0">
				<Button.Style>
					<Style TargetType="Button">
						<Setter Property="Background" Value="#2B579A"/>
						<Setter Property="BorderThickness" Value="0"/>
						<Setter Property="Template">
							<Setter.Value>
								<ControlTemplate TargetType="Button">
									<Border x:Name="border" 
											Background="{TemplateBinding Background}" 
											CornerRadius="6" 
											SnapsToDevicePixels="True">
										<ContentPresenter HorizontalAlignment="Center" 
														  VerticalAlignment="Center"/>
									</Border>
									<ControlTemplate.Triggers>
										<!-- Подсветка при наведении мыши (Hover) -->
										<Trigger Property="IsMouseOver" Value="True">
											<Setter TargetName="border" Property="Background" Value="#3B68AA"/>
										</Trigger>
										<!-- Состояние при клике (Pressed) -->
										<Trigger Property="IsPressed" Value="True">
											<Setter TargetName="border" Property="Background" Value="#1E3E6F"/>
										</Trigger>
									</ControlTemplate.Triggers>
								</ControlTemplate>
							</Setter.Value>
						</Setter>
					</Style>
				</Button.Style>
			</Button>
        </Grid>
    </Border>
</Window>