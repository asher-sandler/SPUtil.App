<Window x:Class="SPUtil.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prism="http://prismlibrary.com/"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:viewmodels="clr-namespace:SPUtil.App.ViewModels"
        xmlns:views="clr-namespace:SPUtil.App.Views"
        xmlns:controls="clr-namespace:SPUtil.App.Controls"
        prism:ViewModelLocator.AutoWireViewModel="True"
        Title="SPUtil - SharePoint Manager (Dual Pane)" 
		Height="800" Width="1500"
		MinHeight="600" MinWidth="1100"
		WindowState="Maximized"
		Closing="Window_Closing">
    
    
    <Window.Resources>
        <DataTemplate DataType="{x:Type viewmodels:List100ViewModel}"><views:List100View /></DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:Library101ViewModel}"><views:Library101View /></DataTemplate>	
        <DataTemplate DataType="{x:Type viewmodels:PagesViewModel}"><views:PagesView /></DataTemplate>	
        <DataTemplate DataType="{x:Type viewmodels:InfoViewModel}"><views:InfoView /></DataTemplate>
		<BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

        <StatusBar Grid.Row="0"  BorderBrush="#DCDCDC" BorderThickness="0,0,0,1" Height="60"
                    FontSize="14">
            <StatusBar.Background>
                <LinearGradientBrush EndPoint="1,1"
                                     StartPoint="0,0">
                    
                    <GradientStop Color="AliceBlue"
                                  Offset="1" />
                    <GradientStop Color="#FFD1E8FB"
                                  Offset="0" />
 
                </LinearGradientBrush>
            </StatusBar.Background>
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" /> 
							<ColumnDefinition Width="250" />  
							<ColumnDefinition Width="Auto" /> 
							<ColumnDefinition Width="*" />    
							<ColumnDefinition Width="Auto" /> 
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem Grid.Column="0"
                           >
                <TextBlock Text="Status: "
                           FontWeight="Bold"
                           Foreground="#555"
                           Margin="5,0,0,0"
                           />
			</StatusBarItem>
			
			<StatusBarItem Grid.Column="1">
                <TextBlock Text="{Binding ConnectionStatus}"
                           Foreground="#2B579A"
                            /> 
			</StatusBarItem>
            <StatusBarItem Grid.Column="2"
                           >
				<StackPanel Orientation="Horizontal">
					<TextBlock Text="Left: " FontWeight="Bold" Foreground="#555"
                                />
                    <TextBlock Text="{Binding LeftUserName}"
                               Margin="0,0,15,0"
                                />
                    <TextBlock Text="Right: "
                               FontWeight="Bold"
                               Foreground="#555"
                                />
                    <TextBlock Text="{Binding RightUserName}"
                                />
				</StackPanel>
			</StatusBarItem>
			
			<StatusBarItem Grid.Column="4" 
						   Cursor="Hand" 
						   MouseLeftButtonDown="Logo_MouseLeftButtonDown"
						   ToolTip="About SPUtil">
				<Image Source="/Views/Huji-BlackLogo.png"
					   Height="55"
					   RenderOptions.BitmapScalingMode="HighQuality"/>
			</StatusBarItem>
        </StatusBar>

        <Menu Grid.Row="1" Background="White" BorderBrush="#DCDCDC" BorderThickness="0,0,0,1" Padding="2">
            <MenuItem Header="_Session">
                <!--MenuItem Header="_Connect As..." 
                  Command="{Binding ConnectAsCommand}">
                    <MenuItem.Icon>
                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center"/>
                    </MenuItem.Icon>
                </MenuItem -->

                <MenuItem Header="_Logout from all SharePoint sites..."
                          Command="{Binding ForgetCredentialsCommand}">
                    <MenuItem.Icon>
                        <TextBlock Text="&#xe748;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center"/>
                    </MenuItem.Icon>
                </MenuItem>
				
				<MenuItem Header="_Open Logs Folder"
						  Command="{Binding OpenLogsFolderCommand}">
					<MenuItem.Icon>
						<TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center"/>
					</MenuItem.Icon>
				</MenuItem>				
				
                <Separator />
                <MenuItem Header="_Exit" Command="{Binding ExitCommand}" />
            </MenuItem>
        </Menu>

        <Grid Grid.Row="2" x:Name="MainContentGrid" SizeChanged="MainContentGrid_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition x:Name="ColSourceDetails" Width="*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition x:Name="ColDestinationDetails" Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <GridSplitter Grid.Column="2" Width="5" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" Background="#DDDDDD"
                          ResizeBehavior="PreviousAndNext" ShowsPreview="True"/>

            <GroupBox Header="Source" Grid.Column="0" Margin="5">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="0.25*"/>
						<ColumnDefinition Width="0.75*"/>
					</Grid.ColumnDefinitions>
					<StackPanel Grid.Column="0" Background="#F0F0F0" Margin="0,0,5,0"
					Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
					
						<StackPanel.Resources>
							<Style TargetType="Button" BasedOn="{StaticResource IconButton}">
								<Setter Property="Margin" Value="2"/>
								<Setter Property="HorizontalAlignment" Value="Stretch"/>
								<Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
							</Style>
						</StackPanel.Resources>
						<Border Height="100" Background="Transparent"/>

						<Button Command="{Binding Tag.CopyEmptyListCommand, RelativeSource={RelativeSource AncestorType=StackPanel}}"
								ToolTipService.ToolTip="Copy List (No Data)">
							<TextBlock Text="&#xE8C8;" Style="{StaticResource IconText}" Foreground="#2B579A"/>
							<!--TextBlock Text="&#xE7BC;" Style="{StaticResource IconText}" Foreground="#2B579A"/-->
						</Button>

						<Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="5,10"/>


						<Button Command="{Binding Tag.CopyListWithDataCommand, RelativeSource={RelativeSource AncestorType=StackPanel}}"
								ToolTipService.ToolTip="Copy List (With Data)">
							<TextBlock Text="&#xE81E;" Style="{StaticResource IconText}" Foreground="#2B579A"/>
							<!--TextBlock Text="&#xE7BC;" Style="{StaticResource IconText}" Foreground="#2B579A"/-->
						</Button>

						<Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="5,10"/>
						<!--
						<Button Command="{Binding Tag.DeleteListCommand, RelativeSource={RelativeSource AncestorType=StackPanel}}" 
								ToolTipService.ToolTip="Delete List">
							<TextBlock Text="&#xE74D;" Style="{StaticResource IconText}" Foreground="#D13438"/>
						</Button>
						
						<Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="5,10"/>
						-->
						<Button Command="{Binding Tag.CompareListsCommand, RelativeSource={RelativeSource AncestorType=StackPanel}}" 
								ToolTipService.ToolTip="Compare Lists">
							<TextBlock Text="&#xE835;" Style="{StaticResource IconText}" Foreground="#484644"/>
						</Button>

						<Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="5,10"/>

						<Button Command="{Binding Tag.ExportListCommand, RelativeSource={RelativeSource AncestorType=StackPanel}}" 
								ToolTipService.ToolTip="Export data">
							<TextBlock Text="&#xEDE2;" Style="{StaticResource IconText}" Foreground="#107C10"/>
						</Button>

						<Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="5,10"/>

						<Button Command="{Binding Tag.ShowSchemaCommand , RelativeSource={RelativeSource AncestorType=StackPanel}}" 
								ToolTipService.ToolTip="Show Schema">
							<TextBlock Text="&#xE71D;" Style="{StaticResource IconText}" Foreground="#0078D4"/>
						</Button>
					</StackPanel>
					
					<DockPanel Grid.Column="1">
						<StackPanel DockPanel.Dock="Top" Margin="5">
							<Label Content="Source URL:"/>
							<!--TextBox Text="{Binding LeftSiteUrl, UpdateSourceTrigger=PropertyChanged}" Height="25"/-->
							<ComboBox Text="{Binding LeftSiteUrl, UpdateSourceTrigger=PropertyChanged}"
									  ItemsSource="{Binding RecentLeftSites}"
									  IsEditable="True" Height="25">
								<ComboBox.InputBindings>
									<KeyBinding Key="Return" Command="{Binding ConnectLeftCommand}"/>
								</ComboBox.InputBindings>
							</ComboBox>
									  
							<StackPanel Orientation="Horizontal" Margin="0,3">
                                
                                <TextBlock Margin="0,3">
									<TextBlock.Style>
										<Style TargetType="TextBlock">
											<Setter Property="Opacity" Value="0"/>
											<Style.Triggers>
												<DataTrigger Binding="{Binding IsLeftConnected}" Value="True">
													<Setter Property="Opacity" Value="1"/>
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</TextBlock.Style>
									<Hyperlink NavigateUri="{Binding LeftSiteFullLink}" 
											   RequestNavigate="Hyperlink_RequestNavigate"
											   >
										<TextBlock Text="Open Site" FontSize="10" Foreground="#2B579A"/>
									</Hyperlink>
                                </TextBlock>
							</StackPanel>							
							
							<Button Content="Connect" Command="{Binding ConnectLeftCommand}" Margin="0,5" Background="#2B579A" Foreground="White"/>
						</StackPanel>
						<Grid DockPanel.Dock="Bottom" Margin="0,5,0,0">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="Auto"/>
								<ColumnDefinition Width="Auto"/>
								<ColumnDefinition Width="Auto"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>
							<TextBox Grid.Column="0" x:Name="TxtSearchLeft" Padding="4,3"
									 TextChanged="TxtSearchLeft_TextChanged"/>
							<Button Grid.Column="1" Content="✕" Width="22" Margin="3,0,0,0"
									Click="BtnClearSearchLeft_Click" ToolTip="Clear search"/>
							<Button Grid.Column="2" Content="▲" Width="22" Margin="3,0,0,0"
									Click="BtnSearchPrevLeft_Click" ToolTip="Previous match"/>
							<Button Grid.Column="3" Content="▼" Width="22" Margin="2,0,0,0"
									Click="BtnSearchNextLeft_Click" ToolTip="Next match"/>
							<TextBlock Grid.Column="4" x:Name="TxtSearchCountLeft" VerticalAlignment="Center"
									   Margin="5,0,0,0" FontSize="10" Foreground="Gray" MinWidth="28"/>
						</Grid>
						<Grid>
						<TreeView x:Name="TvLeft" ItemsSource="{Binding LeftSiteNodes}">
							<TreeView.Resources>
								<!-- Search-selected TreeViewItem keeps focus on the search TextBox,
									 not the tree itself, so WPF renders it with the "inactive
									 selection" brush by default (pale gray). Overriding these two
									 system brushes — SCOPED to this TreeView only, not the whole
									 window — makes the selection look the same (blue/white)
									 whether the tree has focus or not, without affecting selection
									 rendering in unrelated DataGrids elsewhere (that caused the
									 "open page" icon to become invisible when scoped globally). -->
								<SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#0078D4"/>
								<SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White"/>
							</TreeView.Resources>
							<TreeView.ItemContainerStyle>
								<Style TargetType="TreeViewItem">
									<!--Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" /-->
									
									<Setter Property="Tag" Value="{Binding RelativeSource={RelativeSource AncestorType=TreeView}}" />       <Setter Property="ContextMenu">
										<Setter.Value>
										 <ContextMenu>
											<MenuItem Header="{Binding Title}" IsEnabled="False" FontWeight="Bold" Background="#F0F0F0"/>
											<Separator />
											
											<MenuItem Header="Copy structure (empty)" 
													  Command="{Binding PlacementTarget.Tag.DataContext.CopyEmptyListCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
											
											<MenuItem Header="Copy with data" 
													  Command="{Binding PlacementTarget.Tag.DataContext.CopyListWithDataCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
										</ContextMenu>           </Setter.Value>
									</Setter>
									
									<!--Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" / -->
								</Style>
							</TreeView.ItemContainerStyle>					
							<i:Interaction.Triggers>
								<i:EventTrigger EventName="SelectedItemChanged">
									<i:InvokeCommandAction Command="{Binding LeftNodeSelectedCommand}" 
														 CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=TreeView}}"/>
								</i:EventTrigger>
							</i:Interaction.Triggers>
							<TreeView.ItemTemplate>
								<HierarchicalDataTemplate ItemsSource="{Binding Children}">
									<TextBlock Text="{Binding Title}"/>
								</HierarchicalDataTemplate>
							</TreeView.ItemTemplate>
						</TreeView>
							<controls:LoadingOverlay IsBusy="{Binding IsLeftTreeLoading}" LoadingText="Loading site contents, please wait…"/>
						</Grid>
					</DockPanel>
				</Grid>
            </GroupBox>

            <GroupBox Header="Source details" Grid.Column="1" Margin="5">
                <ContentControl Content="{Binding LeftDetailsView}" />
            </GroupBox>

            <GroupBox Header="Destination details" Grid.Column="3" Margin="5">
                <ContentControl Content="{Binding RightDetailsView}" />
            </GroupBox>

            <GroupBox Header="Destination" Grid.Column="4" Margin="5">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="5">
                        <Label Content="Destination URL:"/>
                        <!--TextBox Text="{Binding RightSiteUrl, UpdateSourceTrigger=PropertyChanged}" Height="25"/-->

						<ComboBox Text="{Binding RightSiteUrl, UpdateSourceTrigger=PropertyChanged}"
								  ItemsSource="{Binding RecentRightSites}"
								  IsEditable="True" Height="25">
							<ComboBox.InputBindings>
								<KeyBinding Key="Return" Command="{Binding ConnectRightCommand}"/>
							</ComboBox.InputBindings>
						</ComboBox>

						<StackPanel Orientation="Horizontal" Margin="0,3">
                                <TextBlock Margin="0,3">
									<TextBlock.Style>
										<Style TargetType="TextBlock">
											<Setter Property="Opacity" Value="0"/>
											<Style.Triggers>
												<DataTrigger Binding="{Binding IsRightConnected}" Value="True">
													<Setter Property="Opacity" Value="1"/>
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</TextBlock.Style>

								<Hyperlink NavigateUri="{Binding RightSiteFullLink}" 
										   RequestNavigate="Hyperlink_RequestNavigate" 
										   >
									<TextBlock Text="Open Site" FontSize="10" Foreground="#2B579A"/>
								</Hyperlink>
							</TextBlock>
						</StackPanel>							

                        <Button Content="Connect" Command="{Binding ConnectRightCommand}" Margin="0,5" Background="#2B579A" Foreground="White"/>
                    </StackPanel>
                    <Grid DockPanel.Dock="Bottom" Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="TxtSearchRight" Padding="4,3"
                                 TextChanged="TxtSearchRight_TextChanged"/>
                        <Button Grid.Column="1" Content="✕" Width="22" Margin="3,0,0,0"
                                Click="BtnClearSearchRight_Click" ToolTip="Clear search"/>
                        <Button Grid.Column="2" Content="▲" Width="22" Margin="3,0,0,0"
                                Click="BtnSearchPrevRight_Click" ToolTip="Previous match"/>
                        <Button Grid.Column="3" Content="▼" Width="22" Margin="2,0,0,0"
                                Click="BtnSearchNextRight_Click" ToolTip="Next match"/>
                        <TextBlock Grid.Column="4" x:Name="TxtSearchCountRight" VerticalAlignment="Center"
                                   Margin="5,0,0,0" FontSize="10" Foreground="Gray" MinWidth="28"/>
                    </Grid>
                    <Grid>
                    <TreeView x:Name="TvRight" ItemsSource="{Binding RightSiteNodes}">
                        <TreeView.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#0078D4"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White"/>
                        </TreeView.Resources>
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectedItemChanged">
                                <i:InvokeCommandAction Command="{Binding RightNodeSelectedCommand}" 
                                                     CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=TreeView}}"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <TextBlock Text="{Binding Title}"/>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                        <controls:LoadingOverlay IsBusy="{Binding IsRightTreeLoading}" LoadingText="Loading site contents, please wait…"/>
                    </Grid>
                </DockPanel>
            </GroupBox>
        </Grid>
    </Grid>
</Window>