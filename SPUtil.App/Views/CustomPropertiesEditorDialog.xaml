<Window x:Class="SPUtil.Views.CustomPropertiesEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Custom Properties Editor"
        Width="480" Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="PropRowLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#444"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 0: WP title -->
            <RowDefinition Height="Auto"/>  <!-- 1: StorageKey -->
            <RowDefinition Height="*"/>     <!-- 2: editable properties -->
            <RowDefinition Height="Auto"/>  <!-- 3: Save / Cancel -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TxtWpTitle"
                   FontSize="14" FontWeight="Bold" Foreground="#1a1a7a"
                   TextWrapping="Wrap"/>

        <TextBlock Grid.Row="1" x:Name="TxtWpStorageKey"
                   FontSize="11" Foreground="#666" FontFamily="Consolas"
                   Margin="0,4,0,8"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <TextBlock x:Name="TxtNoProps"
                           Text="No editable custom properties found for this WebPart."
                           TextWrapping="Wrap" Foreground="#AAA" FontStyle="Italic"
                           FontSize="12" Margin="0,20,0,0"
                           Visibility="Collapsed"/>

                <!-- Paths & Files (+ any boolean flags whose name matched the heuristic) -->
                <GroupBox x:Name="PathFileSection" Header="Paths &amp; Files" Margin="0,0,0,10">
                    <ItemsControl x:Name="PathFileList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}"
                                               Style="{StaticResource PropRowLabel}"/>

                                    <TextBox Grid.Column="1" Text="{Binding Value}"
                                             FontSize="11" Padding="3"
                                             Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}"/>

                                    <CheckBox Grid.Column="1" IsChecked="{Binding BoolValue}"
                                              VerticalAlignment="Center"
                                              Visibility="{Binding IsBoolean, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </GroupBox>

                <!-- textAlign / textDirection -->
                <GroupBox x:Name="EnumSection" Header="Text Layout" Margin="0,0,0,10">
                    <ItemsControl x:Name="EnumList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}"
                                               Style="{StaticResource PropRowLabel}"/>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding Options}"
                                              SelectedItem="{Binding SelectedValue}"
                                              FontSize="11"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" Width="90" Height="28"
                    IsCancel="True" Click="BtnCancel_Click" Margin="0,0,8,0"/>
            <Button x:Name="BtnSave" Content="Save" Width="90" Height="28"
                    IsDefault="True" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
