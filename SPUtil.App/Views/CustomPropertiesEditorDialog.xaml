<Window x:Class="SPUtil.Views.CustomPropertiesEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Custom Properties Editor"
        Width="420" Height="220"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TxtWpTitle"
                   FontSize="14" FontWeight="Bold" Foreground="#1a1a7a"
                   TextWrapping="Wrap"/>

        <TextBlock Grid.Row="1" x:Name="TxtWpStorageKey"
                   FontSize="11" Foreground="#666" FontFamily="Consolas"
                   Margin="0,4,0,0"/>

        <TextBlock Grid.Row="2"
                   Text="Custom properties editor — under construction.&#x0a;This dialog will let you edit farm-independent custom WebPart properties directly, without going through the browser."
                   TextWrapping="Wrap" Foreground="#888" FontStyle="Italic"
                   VerticalAlignment="Center" Margin="0,12,0,0"/>

        <Button Grid.Row="3" Content="Close" Width="90" Height="28"
                HorizontalAlignment="Right" IsCancel="True" Click="BtnClose_Click"/>
    </Grid>
</Window>